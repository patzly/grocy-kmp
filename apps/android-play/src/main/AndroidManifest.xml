<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <queries>
    <package android:name="com.patrickzedler.grocy.unlock" />
    <package android:name="com.android.vending" />
  </queries>

  <application
    android:name=".PlayApplication"
    android:icon="${appIcon}"
    android:label="${appLabel}"
    android:localeConfig="@xml/locales_config">

    <!-- Starts the app when a watch asks for the login, the app then publishes it -->
    <service
      android:name=".WatchRequestService"
      android:exported="true">
      <intent-filter>
        <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
        <data
          android:host="*"
          android:path="/grocy/request-connection"
          android:scheme="wear" />
      </intent-filter>
    </service>
  </application>
</manifest>
