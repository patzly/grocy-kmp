<?xml version="1.0" encoding="utf-8"?>
<!-- The calendar list in the picker of Android 12 to 14, from 15 on the widget itself shows -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/widget_preview_surface"
  android:clipToOutline="true"
  android:orientation="vertical">
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="22dp"
    android:paddingEnd="8dp">
    <TextView
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:fontFamily="google-sans-medium"
      android:maxLines="1"
      android:text="@string/widget_preview_calendar"
      android:textColor="@color/widget_preview_text"
      android:textSize="18sp" />
    <FrameLayout
      android:layout_width="56dp"
      android:layout_height="36dp"
      android:background="@drawable/widget_preview_pill">
      <ImageView
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="center"
        android:importantForAccessibility="no"
        android:src="@drawable/widget_ic_add"
        android:tint="@color/widget_preview_on_primary" />
    </FrameLayout>
  </LinearLayout>
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginBottom="4dp"
    android:background="@drawable/widget_preview_chip_3"
    android:minHeight="32dp"
    android:orientation="vertical"
    android:paddingHorizontal="10dp"
    android:paddingVertical="6dp">
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="center_vertical"
      android:orientation="horizontal">
      <ImageView
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:importantForAccessibility="no"
        android:src="@drawable/widget_ic_cleaning_services"
        android:tint="@color/widget_preview_on_event_3" />
      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:fontFamily="google-sans-text-medium"
        android:maxLines="1"
        android:text="@string/widget_sample_vacuum"
        android:textColor="@color/widget_preview_on_event_3"
        android:textSize="14sp" />
    </LinearLayout>
    <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:fontFamily="google-sans-text"
      android:maxLines="1"
      android:text="10:00"
      android:textColor="@color/widget_preview_on_event_3"
      android:textSize="14sp" />
  </LinearLayout>
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginBottom="4dp"
    android:background="@drawable/widget_preview_chip_1"
    android:minHeight="32dp"
    android:orientation="vertical"
    android:paddingHorizontal="10dp"
    android:paddingVertical="6dp">
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="center_vertical"
      android:orientation="horizontal">
      <ImageView
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:importantForAccessibility="no"
        android:src="@drawable/widget_ic_menu_book"
        android:tint="@color/widget_preview_on_event_1" />
      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:fontFamily="google-sans-text-medium"
        android:maxLines="1"
        android:text="@string/widget_sample_spaghetti"
        android:textColor="@color/widget_preview_on_event_1"
        android:textSize="14sp" />
    </LinearLayout>
    <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:fontFamily="google-sans-text"
      android:maxLines="1"
      android:text="@string/widget_sample_lunch"
      android:textColor="@color/widget_preview_on_event_1"
      android:textSize="14sp" />
  </LinearLayout>
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginBottom="4dp"
    android:background="@drawable/widget_preview_chip_2"
    android:minHeight="32dp"
    android:orientation="vertical"
    android:paddingHorizontal="10dp"
    android:paddingVertical="6dp">
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="center_vertical"
      android:orientation="horizontal">
      <ImageView
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:importantForAccessibility="no"
        android:src="@drawable/widget_ic_checklist"
        android:tint="@color/widget_preview_on_event_2" />
      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:fontFamily="google-sans-text-medium"
        android:maxLines="1"
        android:text="@string/widget_sample_mow_lawn"
        android:textColor="@color/widget_preview_on_event_2"
        android:textSize="14sp" />
    </LinearLayout>
  </LinearLayout>
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginBottom="4dp"
    android:background="@drawable/widget_preview_chip_1"
    android:minHeight="32dp"
    android:orientation="vertical"
    android:paddingHorizontal="10dp"
    android:paddingVertical="6dp">
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="center_vertical"
      android:orientation="horizontal">
      <ImageView
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:importantForAccessibility="no"
        android:src="@drawable/widget_ic_kitchen"
        android:tint="@color/widget_preview_on_event_1" />
      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:fontFamily="google-sans-text-medium"
        android:maxLines="1"
        android:text="@string/widget_sample_milk"
        android:textColor="@color/widget_preview_on_event_1"
        android:textSize="14sp" />
    </LinearLayout>
  </LinearLayout>
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginBottom="4dp"
    android:background="@drawable/widget_preview_chip_2"
    android:minHeight="32dp"
    android:orientation="vertical"
    android:paddingHorizontal="10dp"
    android:paddingVertical="6dp">
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="center_vertical"
      android:orientation="horizontal">
      <ImageView
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:importantForAccessibility="no"
        android:src="@drawable/widget_ic_checklist"
        android:tint="@color/widget_preview_on_event_2" />
      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:fontFamily="google-sans-text-medium"
        android:maxLines="1"
        android:text="@string/widget_sample_buy_seeds"
        android:textColor="@color/widget_preview_on_event_2"
        android:textSize="14sp" />
    </LinearLayout>
  </LinearLayout>
</LinearLayout>
