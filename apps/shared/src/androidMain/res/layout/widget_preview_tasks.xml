<?xml version="1.0" encoding="utf-8"?>
<!-- The widget in the picker (Android 12 and newer), a sketch without texts in any language -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/widget_preview_surface"
  android:orientation="vertical">
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="20dp"
    android:paddingEnd="8dp">
    <FrameLayout
      android:layout_width="56dp"
      android:layout_height="14dp"
      android:background="@drawable/widget_preview_bar" />
    <FrameLayout
      android:layout_width="0dp"
      android:layout_height="1dp"
      android:layout_weight="1" />
    <FrameLayout
      android:layout_width="56dp"
      android:layout_height="36dp"
      android:background="@drawable/widget_preview_pill" />
  </LinearLayout>
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp">
    <ImageView
      android:layout_width="24dp"
      android:layout_height="24dp"
      android:importantForAccessibility="no"
      android:src="@drawable/widget_ic_radio_button_unchecked"
      android:tint="@color/widget_preview_content" />
    <FrameLayout
      android:layout_width="120dp"
      android:layout_height="12dp"
      android:layout_marginStart="20dp"
      android:background="@drawable/widget_preview_bar" />
  </LinearLayout>
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp">
    <ImageView
      android:layout_width="24dp"
      android:layout_height="24dp"
      android:importantForAccessibility="no"
      android:src="@drawable/widget_ic_radio_button_unchecked"
      android:tint="@color/widget_preview_content" />
    <FrameLayout
      android:layout_width="90dp"
      android:layout_height="12dp"
      android:layout_marginStart="20dp"
      android:background="@drawable/widget_preview_bar" />
  </LinearLayout>
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp">
    <ImageView
      android:layout_width="24dp"
      android:layout_height="24dp"
      android:importantForAccessibility="no"
      android:src="@drawable/widget_ic_radio_button_unchecked"
      android:tint="@color/widget_preview_content" />
    <FrameLayout
      android:layout_width="140dp"
      android:layout_height="12dp"
      android:layout_marginStart="20dp"
      android:background="@drawable/widget_preview_bar" />
  </LinearLayout>
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp">
    <ImageView
      android:layout_width="24dp"
      android:layout_height="24dp"
      android:importantForAccessibility="no"
      android:src="@drawable/widget_ic_radio_button_unchecked"
      android:tint="@color/widget_preview_content" />
    <FrameLayout
      android:layout_width="70dp"
      android:layout_height="12dp"
      android:layout_marginStart="20dp"
      android:background="@drawable/widget_preview_bar" />
  </LinearLayout>
</LinearLayout>
