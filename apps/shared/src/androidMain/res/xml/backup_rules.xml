<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
  <exclude domain="file" path="datastore/credentials.preferences_pb" />
  <!-- A copy of the server's data, downloaded again after a restore -->
  <exclude domain="database" path="grocy.db" />
  <exclude domain="database" path="grocy.db-wal" />
  <exclude domain="database" path="grocy.db-shm" />
  <!-- Whether Android asked for the local network; a new device has not asked yet -->
  <exclude domain="sharedpref" path="local_network.xml" />
</full-backup-content>
