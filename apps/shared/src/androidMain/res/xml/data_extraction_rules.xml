<?xml version="1.0" encoding="utf-8"?>
<!--
    The login is encrypted with a key that never leaves the Android Keystore,
    so a restored copy could not be decrypted anyway. The database is a copy of the
    server's data, downloaded again after a restore. Whether Android asked for the local
    network belongs to the device.
-->
<data-extraction-rules>
  <cloud-backup>
    <exclude domain="file" path="datastore/credentials.preferences_pb" />
    <exclude domain="database" path="grocy.db" />
    <exclude domain="database" path="grocy.db-wal" />
    <exclude domain="database" path="grocy.db-shm" />
    <exclude domain="sharedpref" path="local_network.xml" />
  </cloud-backup>
  <device-transfer>
    <exclude domain="file" path="datastore/credentials.preferences_pb" />
    <exclude domain="database" path="grocy.db" />
    <exclude domain="database" path="grocy.db-wal" />
    <exclude domain="database" path="grocy.db-shm" />
    <exclude domain="sharedpref" path="local_network.xml" />
  </device-transfer>
</data-extraction-rules>
