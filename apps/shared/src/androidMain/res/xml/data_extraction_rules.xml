<?xml version="1.0" encoding="utf-8"?>
<!--
    The login is encrypted with a key that never leaves the Android Keystore,
    so a restored copy could not be decrypted anyway.
-->
<data-extraction-rules>
  <cloud-backup>
    <exclude domain="file" path="datastore/credentials.preferences_pb" />
  </cloud-backup>
  <device-transfer>
    <exclude domain="file" path="datastore/credentials.preferences_pb" />
  </device-transfer>
</data-extraction-rules>
