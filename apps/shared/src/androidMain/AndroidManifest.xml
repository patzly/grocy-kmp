<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools">

  <!-- Sends what was checked off offline as soon as the device gets a network again -->
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

  <!--
      Self-hosted servers often run in the home network, which Android 17 blocks without it;
      asked for when a request goes there
  -->
  <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

  <!-- The daily notifications, asked for when the user turns one on -->
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <!-- They come at the chosen time; the user allows it in the notification settings -->
  <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
  <!-- Alarms do not survive a restart of the device -->
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

  <!-- Asks Orbot to start Tor when the user routes requests through it -->
  <queries>
    <package android:name="org.torproject.android" />
  </queries>

  <application
    android:allowBackup="true"
    android:dataExtractionRules="@xml/data_extraction_rules"
    android:fullBackupContent="@xml/backup_rules"
    android:networkSecurityConfig="@xml/network_security_config"
    android:supportsRtl="true"
    android:theme="@style/Theme.Grocy"
    tools:targetApi="31">

    <activity
      android:name="com.patrickzedler.grocy.apps.shared.MainActivity"
      android:exported="true"
      android:launchMode="singleTask"
      android:theme="@style/Theme.Grocy.Splash"
      android:windowSoftInputMode="adjustResize">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
      <!--
          grocy:// links open a page of the app (DeepLinks), also from a browser or QR code;
          one task, so a link from another app brings the app forward instead of a copy
      -->
      <intent-filter>
        <action android:name="android.intent.action.VIEW" />
        <category android:name="android.intent.category.DEFAULT" />
        <category android:name="android.intent.category.BROWSABLE" />
        <data android:scheme="grocy" />
      </intent-filter>
      <!-- The same links on NFC tags, opened without asking which app should handle them -->
      <intent-filter>
        <action android:name="android.nfc.action.NDEF_DISCOVERED" />
        <category android:name="android.intent.category.DEFAULT" />
        <data android:scheme="grocy" />
      </intent-filter>
    </activity>

    <receiver
      android:name="com.patrickzedler.grocy.apps.shared.NotificationAlarmReceiver"
      android:exported="false">
      <intent-filter>
        <action android:name="android.intent.action.BOOT_COMPLETED" />
        <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
        <action android:name="android.intent.action.TIME_SET" />
        <action android:name="android.intent.action.TIMEZONE_CHANGED" />
        <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
      </intent-filter>
    </receiver>

    <!-- The home screen widgets; the system's broadcasts to them are protected -->
    <receiver
      android:name="com.patrickzedler.grocy.apps.shared.widget.TaskListWidgetReceiver"
      android:exported="true"
      android:label="@string/widget_tasks_label">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/widget_tasks_info" />
    </receiver>

    <receiver
      android:name="com.patrickzedler.grocy.apps.shared.widget.MonthWidgetReceiver"
      android:exported="true"
      android:label="@string/widget_month_label">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/widget_month_info" />
    </receiver>

    <receiver
      android:name="com.patrickzedler.grocy.apps.shared.widget.ScheduleWidgetReceiver"
      android:exported="true"
      android:label="@string/widget_schedule_label">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/widget_schedule_info" />
    </receiver>

    <!-- Moves the widgets to the new day and sets up their updates again -->
    <receiver
      android:name="com.patrickzedler.grocy.apps.shared.widget.WidgetDayReceiver"
      android:exported="false">
      <intent-filter>
        <action android:name="android.intent.action.BOOT_COMPLETED" />
        <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
        <action android:name="android.intent.action.TIME_SET" />
        <action android:name="android.intent.action.TIMEZONE_CHANGED" />
        <action android:name="android.intent.action.LOCALE_CHANGED" />
      </intent-filter>
    </receiver>
  </application>
</manifest>
